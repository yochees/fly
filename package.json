    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.130.0"
  }
}
