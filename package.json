    "replay": "node scripts/replay.ts",
    "ingest": "node scripts/ingest.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.45.2",
