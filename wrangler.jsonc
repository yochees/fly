{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fly",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    "PUBLIC_BASE_URL": "https://fly.diz.lt",
    "OPENMAIL_INBOX_ADDRESS": "fly@omail.sh",
    "MODEL_FAST": "gpt-5.6-luna",
    "MODEL_STRONG": "gpt-5.6-terra",
    "CONFIDENCE_THRESHOLD": "0.8",
    "SEND_CONFIRMATION": "true"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "fly", "database_id": "bae96c15-d51f-45ab-b70a-c4f73659e832", "migrations_dir": "migrations" }
  ],

  // R2 is optional: it keeps our own copy of attachments. Until it is enabled
  // on the account, the pipeline fetches each file from OpenMail instead.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "fly-files" }],

  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "fly-jobs" }],
    "consumers": [{ "queue": "fly-jobs", "max_batch_size": 1, "max_retries": 4, "dead_letter_queue": "fly-jobs-dlq" }]
  },

  "routes": [
    { "pattern": "fly.diz.lt", "custom_domain": true }
  ]
}
